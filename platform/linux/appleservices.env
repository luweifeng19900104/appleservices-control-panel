# /etc/appleservices/appleservices.env — read by appleservices.service.
# Config only: program, native module, state and logs live under /data/appleservices.
# Never put Apple account credentials here.

# Loopback port of the dashboard. Forward the SAME local port over SSH
# (the dashboard only answers requests whose Host is 127.0.0.1:<this port>).
APPLESERVICES_PORT=18741

# Extra dashboard flags, for example -native-adi=false to fall back to an
# external code provider:
#   APPLESERVICES_EXTRA_ARGS=-native-adi=false -code-provider /data/appleservices/current/bin/adi-code-provider
APPLESERVICES_EXTRA_ARGS=
